# ==============================================================================
# Supabase Authentication & Database Configuration (Phase 1)
# ==============================================================================

# Supabase Public Keys (Safe to be exposed in browser)
# Retrieve these from: Supabase Dashboard -> Project Settings -> API
NEXT_PUBLIC_SUPABASE_URL=https://your-project-id.supabase.co
# Note: Either NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY or NEXT_PUBLIC_SUPABASE_ANON_KEY is accepted
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=your-supabase-publishable-key
# NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key

# Optional Admin Email Allowlist (comma-separated, case-insensitive)
# Used alongside Supabase Auth user metadata role="admin"
ADMIN_EMAILS=admin@yourcompany.com

# Existing Website API Base URL (Calls to your public site's Next.js API routes)
NEXT_PUBLIC_MAIN_WEBSITE_URL=https://www.unlistedpond.com
NEXT_PUBLIC_API_BASE_URL=https://www.unlistedpond.com/api/admin

# ==============================================================================
# CRITICAL SECURITY NOTICE:
# NEVER put your SUPABASE_SERVICE_ROLE_KEY in this file or any NEXT_PUBLIC_* variable!
# The service-role key completely bypasses Row Level Security and must never be exposed.
# ==============================================================================
